@clientAccessToken = long_string_of_characters
@clientRefreshToken = long_string_of_characters
@adminAccessToken = long_string_of_characters
@userId = 42


### register (automatically client, admin has to modify its role for anything else)
POST http://localhost:8080/api/auth/register
Content-Type: application/json

{
  "firstName": "Test",
  "lastName": "Client",
  "email": "client@gmail.com",
  "phoneNumber": "+40712345678",
  "password": "GottaBeAtLeast8"
}


### login
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "client@gmail.com",
  "password": "GottaBeAtLeast8"
}


### get the current user's data (as the current user)
GET http://localhost:8080/api/auth/me
Authorization: Bearer {{clientAccessToken}}


### update the current user's data (as the current user)
PUT http://localhost:8080/api/auth/me
Authorization: Bearer {{clientAccessToken}}
Content-Type: application/json

{
  "firstName": "Test",
  "lastName": "Client",
  "username": "ChangedItFromMyFirstNameSinceLike40%OfTheUsersHadThisAsTheirUsernameForSomeReason",
  "email": "client@gmail.com",
  "phoneNumber": "0999999999"
}


### create (only admin can create another user)
POST http://localhost:8080/api/users
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "firstName": "New",
  "lastName": "Person",
  "email": "new@gmail.com",
  "phoneNumber": "0700000000",
  "password": "ANewPasswordWhoa",
  "role": "CLIENT"
}


### get all users (only admin can get all users)
GET http://localhost:8080/api/users
Authorization: Bearer {{adminAccessToken}}


### get by ID
GET http://localhost:8080/api/users/{{userId}}
Authorization: Bearer {{adminAccessToken}}


### update (only admin can update another user)
PUT http://localhost:8080/api/users/{{userId}}
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "firstName": "New",
  "lastName": "Updated",
  "username": "New",
  "email": "reallyNew@gmail.come",
  "phoneNumber": "0799999999"
}


### delete (only admin can delete another uder)
DELETE http://localhost:8080/api/users/{{userId}}
Authorization: Bearer {{adminAccessToken}}


### refresh client access tokens
POST http://localhost:8080/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{clientRefreshToken}}"
}


### logout
POST http://localhost:8080/api/auth/logout
Authorization: Bearer {{clientAccessToken}}
Content-Type: application/json

{
  "refreshToken": "{{clientRefreshToken}}"
}


### change password (expect 501 for now)
PUT http://localhost:8080/api/auth/change-password
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "currentPassword": "LameOldPasswordEw",
  "newPassword": "VeryCoolNewPassword"
}


### forgot password placeholder (expect 501 for now)
POST http://localhost:8080/api/auth/forgot-password
Content-Type: application/json

{
  "email": "client@gmail.com"
}


### reset password placeholder (expect 501 for now)
POST http://localhost:8080/api/auth/reset-password
Content-Type: application/json

{
  "token": "not-implemented",
  "newPassword": "VeryCoolNewPassword"
}
